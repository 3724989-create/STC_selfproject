  10          
  11          // **** 系统定义 ****************
  12          // ==== 单片机 SFR定义 ==========================
  13          #include "uCx51_SFR_STC8H.h"
  14          
  15          // ==== 库函数 ==========================
  16          #include "stdio.h"
  17          
  18          // **** 主函数 单片机程序入口 ****************
  19          void main(void){                
  20   1              float           X, Y, Z;
  21   1              
  22   1      // ==== 单片机系统 初始化 ===========
  23   1      // ---- 系统串口1 波特率 115200 Timer2 33.1776MHz -------------
  24   1                              SCON = 0x50;            // 8位数据,可变波特率
  25   1                              AUXR |= 0x01;           // 串口1选择定时器2为波特率发生器
  26   1                              AUXR &= 0xFB;           // 定时器时钟12T模式
  27   1                              T2L = 0xFA;                     // 设置定时初始值
  28   1                              T2H = 0xFF;                     // 设置定时初始值
  29   1                              AUXR |= 0x10;           // 定时器2开始计时
  30   1                              PS   =0x01;                     // 最高优先级
  31   1                              ES  = 0;                                // 不允许串口中断                       
  32   1                              TI      = 1;                            // 发送缓冲区已清空
  33   1              
  34   1      // ==== 后台任务主循环 ====================
  35   1      Main_Loop:                              
  36   1                              printf("\r\n 请输入 X,Y<CR>");
  37   1                              scanf("%f,%f", &X, &Y);
  38   1              
  39   1                              Z=X+Y;
  40   1                              printf("X+Y=%f", Z);
  41   1                                      
  42   1      // ---- 后台任务主循环 结束 -----------------
  43   1                              goto Main_Loop;         
  44   1      }
