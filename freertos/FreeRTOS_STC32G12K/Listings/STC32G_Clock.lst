   14          #include        "STC32G_Clock.h"
   15          #include        "STC32G_Delay.h"
   16          
   17          //========================================================================
   18          // 函数: void HIRCClkConfig(u8 div)
   19          // 描述: 高速IRC时钟初始化程序.
   20          // 参数: div: 时钟分频系数.
   21          // 返回: none.
   22          // 版本: V1.0, 2022-04-03
   23          //========================================================================
   24          void HIRCClkConfig(u8 div)
   25          {
   26   1              HIRCCR = 0x80; //启动内部 IRC
   27   1              while (!(HIRCCR & 1)); //等待时钟稳定
   28   1              CLKDIV = div;
   29   1              CLKSEL = 0x00; //选择内部 IRC ( 默认 )
   30   1      }
   31          
   32          //========================================================================
   33          // 函数: void XOSCClkConfig(u8 div)
   34          // 描述: 外部晶振时钟初始化程序.
   35          // 参数: div: 时钟分频系数.
   36          // 返回: none.
   37          // 版本: V1.0, 2022-04-03
   38          //========================================================================
   39          void XOSCClkConfig(u8 div)
   40          {
   41   1              XOSCCR = 0xc0; //启动外部晶振
   42   1              while (!(XOSCCR & 1)); //等待时钟稳定
   43   1              CLKDIV = div;  //时钟分频
   44   1              CLKSEL = 0x01; //选择外部晶振
   45   1      }
   46          
   47          //========================================================================
   48          // 函数: void IRC32KClkConfig(u8 div)
   49          // 描述: 低速32K IRC时钟初始化程序.
   50          // 参数: div: 时钟分频系数.
   51          // 返回: none.
   52          // 版本: V1.0, 2022-04-03
   53          //========================================================================
   54          void IRC32KClkConfig(u8 div)
   55          {
   56   1              IRC32KCR = 0x80; //启动内部 32K IRC
   57   1              while (!(IRC32KCR & 1)); //等待时钟稳定
C251 COMPILER V5.60.0,  STC32G_Clock                                                       03/12/25  17:09:38  PAGE 2   

   58   1              CLKDIV = div;  //时钟分频
   59   1              CLKSEL = 0x03; //选择内部 32K
   60   1      }
   61          
   62          //========================================================================
   63          // 函数: void HSPllClkConfig(u8 clksrc, u8 pcki, u8 pllsel, u8 div)
   64          // 描述: 高速IO时钟初始化程序.
   65          // 参数: clksrc: 系统时钟选择, MCLKSEL_HIRC/MCLKSEL_XIRC/MCLKSEL_X32K/MCLKSEL_I32K/MCLKSEL_PLL/MCLKSEL_PL
             -L2/MCLKSEL_I48M.
   66          // 参数: pllsel: PLL时钟选择, PLL_96M/PLL_144M.
   67          // 参数: div: 高速IO时钟分频系数.
   68          // 返回: none.
   69          // 版本: V1.0, 2022-04-03
   70          //========================================================================
   71          void HSPllClkConfig(u8 clksrc, u8 pllsel, u8 div)
   72          {
   73   1              MainClockSel(clksrc);                   //系统时钟选择, MCLKSEL_HIRC/MCLKSEL_XIRC/MCLKSEL_X32K/MCLKSEL_I32K/MCLKSEL_PLL/
             -MCLKSEL_PLL2/MCLKSEL_I48M
   74   1      
   75   1              //系统时钟 n 分频作为PLL时钟源,确保分频后为12M
   76   1          USBCLK &= ~PCKI_MSK;
   77   1      #if (MAIN_Fosc == 12000000UL)
                   USBCLK |= PCKI_D1;          //PLL输入时钟1分频
               #elif (MAIN_Fosc == 24000000UL)
   80   1          USBCLK |= PCKI_D2;          //PLL输入时钟2分频
   81   1      #elif (MAIN_Fosc == 48000000UL)
                   USBCLK |= PCKI_D4;          //PLL输入时钟4分频
               #elif (MAIN_Fosc == 96000000UL)
                   USBCLK |= PCKI_D8;          //PLL输入时钟8分频
               #else
                   USBCLK |= PCKI_D1;          //默认PLL输入时钟1分频
               #endif
   88   1      
   89   1              PLLClockSel(pllsel);                    //PLL时钟选择, PLL_96M/PLL_144M
   90   1              PLLEnable(ENABLE);                              //PLL倍频使能, ENABLE/DISABLE
   91   1              delay_ms(1);              //等待PLL锁频
   92   1              HSIOClockSel(HSCK_PLL);         //高速IO时钟选择, HSCK_MCLK/HSCK_PLL
   93   1              HSClockDiv(div);                                        //高速IO时钟分频系数
   94   1      }
