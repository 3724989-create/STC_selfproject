 3083          void vTaskPlaceOnEventList( List_t * const pxEventList,
 3084                                      const TickType_t xTicksToWait )
 3085          {
 3086   1          configASSERT( pxEventList );
 3087   1      
 3088   1          /* THIS FUNCTION MUST BE CALLED WITH EITHER INTERRUPTS DISABLED OR THE
 3089   1           * SCHEDULER SUSPENDED AND THE QUEUE BEING ACCESSED LOCKED. */
 3090   1      
 3091   1          /* Place the event list item of the TCB in the appropriate event list.
 3092   1           * This is placed in the list in priority order so the highest priority task
 3093   1           * is the first to be woken by the event.
 3094   1           *
 3095   1           * Note: Lists are sorted in ascending order by ListItem_t.xItemValue.
 3096   1           * Normally, the xItemValue of a TCB's ListItem_t members is:
 3097   1           *      xItemValue = ( configMAX_PRIORITIES - uxPriority )
 3098   1           * Therefore, the event list is sorted in descending priority order.
 3099   1           *
 3100   1           * The queue that contains the event list is locked, preventing
 3101   1           * simultaneous access from interrupts. */
 3102   1          vListInsert( pxEventList, &( pxCurrentTCB->xEventListItem ) );
 3103   1      
 3104   1          prvAddCurrentTaskToDelayedList( xTicksToWait, pdTRUE );
 3105   1      }
