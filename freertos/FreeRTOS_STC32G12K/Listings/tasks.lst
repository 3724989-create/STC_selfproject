 4002   1          {
 4003   2              /* The new current delayed list is empty.  Set xNextTaskUnblockTime to
 4004   2               * the maximum possible value so it is  extremely unlikely that the
 4005   2               * if( xTickCount >= xNextTaskUnblockTime ) test will pass until
 4006   2               * there is an item in the delayed list. */
 4007   2              xNextTaskUnblockTime = portMAX_DELAY;
 4008   2          }
 4009   1          else
 4010   1          {
 4011   2              /* The new current delayed list is not empty, get the value of
 4012   2               * the item at the head of the delayed list.  This is the time at
 4013   2               * which the task at the head of the delayed list should be removed
 4014   2               * from the Blocked state. */
 4015   2              xNextTaskUnblockTime = listGET_ITEM_VALUE_OF_HEAD_ENTRY( pxDelayedTaskList );
 4016   2          }
 4017   1      }
