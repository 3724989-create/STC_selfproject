   40          //任务运行时间统计功能
   41          #if configGENERATE_RUN_TIME_STATS == 1
   42          
   43          u32 FreeRTOSRunTimeTicks;
   44              
   45          /*-------------------------------------------------------------
   46          定时器3配置, 任务运行时间统计功能使用定时器3时钟
   47          -------------------------------------------------------------*/
   48          #define TIM3_TICKS_PER_SEC    10000
   49          #define TM3PS_VALUE    ( MAIN_Fosc / TIM3_TICKS_PER_SEC / 65536UL )
   50          #define RELOAD_VALUE   ( 65536UL - MAIN_Fosc / (TM3PS_VALUE+1U) / TIM3_TICKS_PER_SEC )
   51          void Timer3_Init(void)          //500微秒@11.0592MHz
   52          {
   53   1              T4T3M |= 0x02;                                      //定时器时钟1T模式
   54   1              T3L = ( uint8_t )( RELOAD_VALUE );          //设置定时初始值
   55   1              T3H = ( uint8_t )( RELOAD_VALUE >> 8 );     //设置定时初始值
   56   1          T3IF = 0;                                   //清除标志
   57   1          ET3 = 1;                                    //开中断
C251 COMPILER V5.60.0,  StatisticalOs                                                      03/12/25  17:09:39  PAGE 2   

   58   1              T3R = 1;                                                //定时器3开始计时
   59   1      }
   60          
   61          
   62          /*-------------------------------------------------------------------- 
   63          Timer3中断
   64          --------------------------------------------------------------------*/
   65          void Timer3_ISR_Handler (void) interrupt TMR3_VECTOR
   66          {
   67   1              FreeRTOSRunTimeTicks++;
   68   1      }
   69          
   70          //初始化一个硬件定时器
   71          void ConfigureTimeForRunTimeStats(void)
   72          {
   73   1              FreeRTOSRunTimeTicks = 0;
   74   1              Timer3_Init();
   75   1      }
   76          
   77          //返回计数器的值
   78          u32 GetFreeRTOSRunTimeTicks(void)
   79          {
   80   1              u32 val;
   81   1              u8      cpu_sr;
   82   1              cpu_sr = portSET_INTERRUPT_MASK_FROM_ISR();
   83   1              val = FreeRTOSRunTimeTicks;
   84   1              portCLEAR_INTERRUPT_MASK_FROM_ISR(cpu_sr);
   85   1              return val;
   86   1      }
