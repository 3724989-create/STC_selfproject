   76          /*-----------------------------------------------------------*
   77          PendSv 中断做任务切换
   78          *-----------------------------------------------------------*/
   79          void PendSvIsr( void )
   80          {
   81   1          __asm{  PendSvIsr_Entrance:     }
   82   1          __asm{  CLR     EA  }
   83   1      
   84   1          //寄存器入栈
   85   1          portSAVE_CONTEXT();
   86   1                      
   87   1              //SP保存到任务控制块                        
   88   1          __asm{  MOV   DR0,DR60          }           
   89   1          __asm{  MOV   DR4,pxCurrentTCB  }   
   90   1          __asm{  MOV   @WR6+0x2,WR2      }
   91   1      
   92   1          PendSv_ClearFlag(); 
   93   1                      
   94   1              //找出即将要运行的任务
   95   1              vTaskSwitchContext();  
   96   1                      
   97   1              //读取任务的SP
   98   1          __asm{  MOV   DR4,pxCurrentTCB  }   
   99   1          __asm{  MOV   WR2,@WR6+0x2      }   
  100   1          __asm{  MOV   DR60,DR0          }           
  101   1                      
  102   1          //寄存器出栈
  103   1          portRESTORE_CONTEXT();
  104   1              
  105   1          __asm{  SETB    EA  }
  106   1              __asm{  RETI        }              
  107   1      }
