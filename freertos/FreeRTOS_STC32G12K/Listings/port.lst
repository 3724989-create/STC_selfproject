   26          #define portTM0PS_VALUE    ( configCPU_CLOCK_HZ / configTICK_RATE_HZ / 65536UL )
   27          #define portRELOAD_VALUE   ( 65536UL - configCPU_CLOCK_HZ / (portTM0PS_VALUE+1) / configTICK_RATE_HZ )
   28          static void prvPortSetupTimerInterrupt( void )
   29          {
   30   1              AUXR    |=      0x80;   //1T模式
   31   1              TMOD    &=      0XF0;   //模式0
   32   1              TM0PS   =       portTM0PS_VALUE;        //分频系数
   33   1          TL0 = ( uint8_t )( portRELOAD_VALUE );              //装载值
   34   1          TH0 = ( uint8_t )( portRELOAD_VALUE >> 8 ); //装载值
   35   1              TF0 = 0;        //清除标志
   36   1              ET0 = 1;        //使能中断
   37   1              TR0 = 1;        //开启定时器
   38   1      }
