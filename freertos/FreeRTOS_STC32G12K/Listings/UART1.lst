   89   2              tx_w_addr+=Size;
   90   2          }
   91   1          else{
   92   2              u16 len = UART1_TX_BUF_SIZE-tx_w_addr;
   93   2              memcpy(&TX_BUF[tx_w_addr],buf,len);
   94   2              buf+=len;
   95   2              len=Size-len;
   96   2              memcpy(&TX_BUF[0],buf,len);
   97   2              tx_w_addr=len;
   98   2          }
   99   1          
  100   1          portENTER_CRITICAL();
  101   1          TX_W_ADDR = tx_w_addr;
  102   1          if(TX_IDLE){
