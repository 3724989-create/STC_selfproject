  106   3                  DMA_UR1T_AMTH = (TX_DMA_SIZE-1)>>8;             //字节数
  107   3                  DMA_UR1T_AMT  = (TX_DMA_SIZE-1);                //字节数
  108   3                  DMA_UR1T_TXAH = (u16)(&TX_BUF[TX_R_ADDR])>>8;   //地址
  109   3                  DMA_UR1T_TXAL = (u16)(&TX_BUF[TX_R_ADDR]);      //地址
  110   3                  DMA_UR1T_CR   = 0XC0;                           //启动DMA
  111   3              }
  112   2          }
  113   1          portEXIT_CRITICAL();
  114   1              
  115   1          return 0;
  116   1      }
