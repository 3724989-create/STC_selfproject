   37   1          {
   38   2              TX_DMA_SIZE = (TX_W_ADDR>TX_R_ADDR)? TX_W_ADDR-TX_R_ADDR : UART1_TX_BUF_SIZE-TX_R_ADDR;
   39   2              DMA_UR1T_AMTH = (TX_DMA_SIZE-1)>>8;             //字节数
   40   2              DMA_UR1T_AMT  = (TX_DMA_SIZE-1);                //字节数
   41   2              DMA_UR1T_TXAH = (u16)(&TX_BUF[TX_R_ADDR])>>8;   //地址
   42   2              DMA_UR1T_TXAL = (u16)(&TX_BUF[TX_R_ADDR]);      //地址
   43   2              DMA_UR1T_CR   = 0XC0;                           //启动DMA
   44   2          }
   45   1          else{
   46   2              TX_IDLE = 1;
   47   2          }
   48   1      }
