   59          void Task2(void * pvParameters) 
   60          {
   61   1              while(1)
   62   1              {
   63   2                      static u8 xdata Visualization[512];
   64   2              
   65   2              xSemaphoreTake(Uart1Mutex,portMAX_DELAY);
   66   2              
   67   2              vTaskList(Visualization);   //获取任务信息 
   68   2                      printf("任务信息：\r\n");    //
   69   2                      printf(Visualization);      //
   70   2              printf("\r\n");
   71   2              
   72   2                      printf("任务运行时间统计信息：\r\n");  //
   73   2                      vTaskGetRunTimeStats(Visualization);    //获取任务运行时间统计信息
   74   2                      printf(Visualization);                                  //输出到串口
   75   2              
   76   2              xSemaphoreGive(Uart1Mutex);
   77   2                      
   78   2                      vTaskDelay(1000);
   79   2              
   80   2                      P46 = !P46;
   81   2              }
   82   1              if(pvParameters);
   83   1      }
