   11          
   12          void Task2(void * pvParameters);
   13          
   14          
   15          QueueHandle_t           testBinary; //二值信号量
   16          xSemaphoreHandle        testSem;    //计数信号量
   17          xSemaphoreHandle        Uart1Mutex; //RTOS 互斥信号量
   18          
   19          void StartTask(void * pvParameters)
   20          {
   21   1              UART1_Init(115200);
   22   1              
   23   1              vSemaphoreCreateBinary( testBinary );           //创建信号量
   24   1              
   25   1              testSem = xSemaphoreCreateCounting(255,0);      //创建信号量
   26   1              
   27   1              Uart1Mutex = xSemaphoreCreateMutex();           //创建信号量
   28   1              
   29   1              xTaskCreate((TaskFunction_t ) Task2,
   30   1                      (const char*    ) "task2",
   31   1                      (uint16_t       ) 256,
   32   1                      (void*          ) NULL,                 //
   33   1                      (UBaseType_t    ) 4,                    //优先级
   34   1                      (TaskHandle_t*  ) NULL  );
   35   1              
   36   1              while(1)
   37   1              {
   38   2              u8 uart_dat[16],len;
   39   2              
   40   2              xSemaphoreTake(Uart1Mutex,portMAX_DELAY);
   41   2              do{
   42   3                  len = UART1_Receive(uart_dat,16);   
   43   3                  UART1_Send(uart_dat,len);           //原路返回串口收到的数据
   44   3              }while(len==16);
   45   2              xSemaphoreGive(Uart1Mutex);
   46   2      
   47   2                      vTaskDelay(20);
   48   2              }
   49   1              
   50   1              if(pvParameters);
   51   1      }
