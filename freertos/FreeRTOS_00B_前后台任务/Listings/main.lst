  13          // **** 系统定义 ****************
  14          // ==== 单片机 SFR定义 ==========================
  15          #include "uCx51_SFR_STC8H.h"
  16          
  17          // ==== 库函数 ==========================
  18          #include "stdio.h"
  19          
  20          // ==== 公共变量 =====================
  21          long            Tick0;
  22          
  23          // **** 主函数 单片机程序入口 ****************
  24          void main(void){                
  25   1              float           X, Y, Z;
  26   1              
  27   1      // ==== 单片机系统 初始化 ===========
  28   1      // ---- 系统串口1 波特率 115200 Timer2 33.1776MHz -------------
  29   1                              SCON = 0x50;            // 8位数据,可变波特率
  30   1                              AUXR |= 0x01;           // 串口1选择定时器2为波特率发生器
  31   1                              AUXR &= 0xFB;           // 定时器时钟12T模式
  32   1                              T2L = 0xFA;                     // 设置定时初始值
  33   1                              T2H = 0xFF;                     // 设置定时初始值
  34   1                              AUXR |= 0x10;           // 定时器2开始计时
  35   1                              PS   =0x01;                     // 最高优先级
  36   1                              ES  = 0;                                // 不允许串口中断                       
  37   1                              TI      = 1;                            // 发送缓冲区已清空
  38   1              
  39   1      // ---- 定时器0 10毫秒@33.1776MHz ---------------------
  40   1                              AUXR &= 0x7F;                   // 定时器时钟12T模式
  41   1                              TMOD &= 0xF0;                   // 设置定时器模式
  42   1                              TL0 = 0x00;                             // 设置定时初始值
  43   1                              TH0 = 0x94;                             // 设置定时初始值
  44   1                              TF0 = 0;                                        // 清除TF0标志
  45   1                              TR0 = 1;                                        // 定时器0开始计时
  46   1                              ET0=1;                                          // 允许中断
  47   1              
  48   1      // ==== 程序数据 初始化 =========
  49   1                              Tick0=0;        
  50   1              
  51   1      // ==== 系统开始运行 ===========
  52   1      // ---- 打开中断 ----------     
  53   1                              EA=1;
  54   1                              
C51 COMPILER V9.60.7.0   MAIN                                                              11/29/2025 19:16:27 PAGE 2   

  55   1              
  56   1      // ==== 后台任务主循环 ====================
  57   1      Main_Loop:                              
  58   1                              printf("\r\n 请输入 X,Y<CR>");
  59   1                              scanf("%f,%f", &X, &Y);
  60   1              
  61   1                              Z=X+Y;
  62   1                              printf("X+Y=%f", Z);
  63   1                                      
  64   1      // ---- 后台任务主循环 结束 -----------------
  65   1                              goto Main_Loop;         
  66   1      }
  67          
  68          // **** 定时器0 中断服务程序 ****************
  69          void Timer0_ISR (void) interrupt 1
  70          {               
  71   1      // ---- 节拍计数 +1 ---------------     
  72   1                              Tick0++;
  73   1              
  74   1      // ---- 每1000毫秒 ---------------      
  75   1                              if((Tick0 % 100)==0) {
  76   2                                      printf("\n前台任务 --> %ld", Tick0);
  77   2                              }
  78   1                                                      
  79   1      }
