   62          //================================================================
   63          // 接口定义: 利用LCD1602接口(反相排序)
   64          // 1602:  K- A+  D7  D6  D5  D4  D3  D2 D1 D0 E WR RS Vo VCC GND
   65          // OLED: GND VCC SCL SDA RES DC  CS     12864单色OLED
   66          // TFT:  GND VCC P25 P23 P20 P21 P22 BL 128160 TFT     
   67          //================================================================
   68          sbit SCL = P2^5;  //时钟端
   69          sbit SDA = P2^3;  //数据端
   70          sbit RES = P2^0;  //复位端 0:复位
   71          sbit  DC = P2^1;  //0:指令/1:数据
   72          sbit  CS = P2^2;  //片选 0:选中
   73          sbit  BL = P2^7;  //背光 0:灭 1:亮
   74          //========================================================
   75          //函数说明
   76          void delay(u16 count);     //延时
   77          void LCD_WR_CMD(u8 Cmd);   //写命令 
   78          void LCD_WR_DAT(u8 Dat);   //写数据 
   79          //========================================================
   80          // 非精确延时函数
   81          //========================================================
   82          void delay(u16 count)
   83          { unsigned int i,j;
   84   1        for(i=0;i<count;i++)       
   85   1          for(j=0;j<500;j++);             
   86   1      }
   87          //========================================================
   88          // SPI接口写一字节数据基本函数
   89          //========================================================
   90          void SPI_WriteByte(u8 Byte)
   91          { int i;
   92   1        for(i=0;i<8;i++)
   93   1        { if(Byte &0x80)SDA=1;
   94   2          else          SDA=0;
   95   2          SCL=0;
   96   2          SCL=1;
   97   2          Byte<<=1;
   98   2        }
   99   1      }
  100          //========================================================
  101          // 写命令基本函数 8位数 一字节
  102          //========================================================
  103          void LCD_WR_CMD(u8 Cmd)
  104          { 
  105   1        CS=0;
  106   1        DC=0;
  107   1        SPI_WriteByte(Cmd);
  108   1        CS=1; 
  109   1      }
  110          //========================================================
  111          // 写数据令基本函数 8位数 一字节
  112          //========================================================
  113          void LCD_WR_DAT(u8 Dat)
  114          { 
  115   1        CS=0;
  116   1        DC=1;
  117   1        SPI_WriteByte(Dat);
  118   1        CS=1;
  119   1      }
  120          //========================================================
  121          // 写数据令基本函数 16位数 2字节
  122          //========================================================
  123          void LCD_WR_DATA(u16 Data)
C251 COMPILER V5.60.0,  self_LCD                                                           20/11/25  12:56:40  PAGE 3   

  124          {
  125   1        CS=0;
