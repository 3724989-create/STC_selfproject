   20          void ccd_process_data(void)
   21          {
   22   1          // 检查是否有数据采集完成 (此检查冗余，因为外部已检查 tsl1401_finish_flag)
   23   1          // if (!tsl1401_finish_flag) return; 
   24   1          
   25   1          // TSL1401_AD_RESOLUTION 被定义为 ADC_12BIT (0-4095)
   26   1          // 压缩系数为 4096 / 128 = 32
   27   1          u8 j;
   28   1          const u16 COMPRESSION_DIVER=32;
   29   1          const u8 MAX_NOMPRESSED_VALUE=128;
   30   1      
   31   1          for( j=0;j<128;j++)
   32   1          {
   33   2               // 压缩逻辑: 128 - (ADC_VALUE / 32)
   34   2               // 实现：高亮度 (高 ADC 值) 对应低压缩值 (接近 0)
   35   2               // ADC 值 4095 -> 128 - 128 = 0
   36   2               // ADC 值 0 -> 128 - 0 = 128
   37   2               y1_boundary[j]=(u8)(MAX_NOMPRESSED_VALUE-tsl1401_data[0][j] / COMPRESSION_DIVER);
   38   2          }
   39   1           // 此时 y1_boundary 已经准备好供 LCD 绘制
   40   1      }
