  330          ** 参数: X列Y行坐标, * str串指针, Fcolor字前景色,Bcolor字背景色,约定:色号80为透明
             -,Len指定长度
  331          =========================================================================================================
             -==========*/
  332          void LCD_A16(unsigned int X,unsigned int Y, char *str,unsigned char Fcolor,unsigned char Bcolor,unsigned 
             -char Len)
  333          { /* 行Y(0-479) 列X(0-319) */
  334   1        char i,buf,A,n;
  335   1        unsigned int j,l;
  336   1        l=Len;                          //strlen(str);
  337   1        for(i=0;i<l;i++)                /* 逐个显示字符串 */
  338   1        {  A=str[i];                    /* 显示西文ASCII字符   */
  339   2           for(j=0;j<16;j++)
  340   2           { /* 写16行 */
  341   3             buf = ASC16[A-32][j];      /* 取字模 */
  342   3             LCD_MoveTo(X+i*8,Y+j);         /* 字符左上角显示地址 */
  343   3             for(n=0;n<8;n++)          /* 西文字母横向显示8点 */
  344   3             { if((buf&0x80)==0x80)LCD_WR_DATA(COLOR[Fcolor]);   /* 字模点为1显示前景色 */
  345   4              else                                              /* 字模点为0显示原底色或背景色 */
  346   4              { if(Bcolor==80){ LCD_MoveTo(X+i*8+n,Y+j); }          /* 透明显示模式: 仅地址+1定位 */
  347   5                else  LCD_WR_DATA(COLOR[Bcolor]);                /* 正常显示模式:背景色 */
  348   5              }
  349   4              buf = buf << 1; 
  350   4             } /* 水平8点显示完毕 */
  351   3           }  /* 一个8*16点阵西文字符显示完毕 */
  352   2        }    /* while   */
  353   1      }     /* A16()   */
