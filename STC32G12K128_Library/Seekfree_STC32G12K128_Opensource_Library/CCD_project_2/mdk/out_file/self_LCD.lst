  439          void LCD_BMP(unsigned char X,unsigned char Y,unsigned char W,unsigned char H,unsigned char * pic)
  440          {       u16 i;
  441   1        u8 h,l;
  442   1              LCD_SetBox(X,Y,W,H);         //设置显示窗口
  443   1        for(i=0;i<W*H;i++)
  444   1        { l=pic[2*i]; h=pic[2*i+1];  //图像数据:低位在前/高位在后
  445   2          LCD_WR_DAT(h);             //显示彩色点(高位在前)
  446   2          LCD_WR_DAT(l);             //显示彩色点(低位在后) 
  447   2        }
  448   1              LCD_SetBox(0,0,Width,Height);//恢复全屏区域
  449   1      }
