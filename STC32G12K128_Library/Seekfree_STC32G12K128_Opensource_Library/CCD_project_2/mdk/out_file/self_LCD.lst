  451          void LCD_gpio_Init(void)
  452          {
  453   1        unsigned char i;
  454   1        unsigned int wait=0;
  455   1        //IO端口初始化
  456   1        WTST  = 0; //设置程序指令延时参数，赋值为0可将CPU执行指令的速度设置为最快
  457   1        EAXFR = 1; //扩展寄存器(XFR)访问使能
  458   1        CKCON = 0; //提高访问XRAM速度
  459   1        //IO端口初始化//全部为双向口
  460   1        P0M1 = 0x00;   P0M0 = 0x04;   //设置为准双向口: P0.2推挽输出控制背光
  461   1        P1M1 = 0x00;   P1M0 = 0x00;   //设置为准双向口
  462   1          // 【关键修复：将 P2 端口所有 LCD 控制引脚设置为推挽输出】
  463   1        // P2.0, P2.1, P2.2, P2.3, P2.5, P2.7 (RES, DC, CS, SDA, SCL, BL) 设置为推挽输出 (0xAF)
  464   1        P2M1 = 0x00;   P2M0 = 0xAF;   //设置为准双向口
  465   1        P3M1 = 0x00;   P3M0 = 0x00;   //设置为准双向口
  466   1        P4M1 = 0x00;   P4M0 = 0x00;   //设置为准双向口
  467   1        P5M1 = 0x00;   P5M0 = 0x00;   //设置为准双向口
  468   1        LCD_Init();
  469   1        LCD_CLS(1);             //蓝色清屏
  470   1      }
